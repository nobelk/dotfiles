{
    // macOS login shell (zsh). Set to "Zsh" to force a non-login interactive shell.
    "default_config": {
        "osx": null
    },

    // Default is 10000 - long `go test ./...` runs scroll past it.
    "scrollback_history_size": 50000,

    // Follows the active Sublime color scheme instead of pinning light or dark.
    // Note: User/Terminus/Terminus.hidden-color-scheme is GENERATED by the
    // "Terminus Utilities: Select Theme" command - do not hand-edit it.
    // Use "user" + user_theme_colors below if you want manual control.
    "theme": "adaptive",

    "256color": true,
    "brighten_bold_text": true,
    "unix_term": "xterm-256color",
    "unix_lang": "en_US.UTF-8",

    // Default true reopens dead terminal tabs on window restore, usually with a stale cwd.
    "reactivate_terminals": false,

    // Terminal views are real Sublime views and inherit editor chrome unless disabled.
    // Keep this block in sync with "Terminus View.sublime-settings".
    "view_settings": {
        "font_face": "FiraMono Nerd Font Mono",
        "font_size": 12,
        "line_padding_top": 0,
        "line_padding_bottom": 0,
        "scroll_past_end": false,
        "draw_white_space": "none",
        "highlight_line": false,
        "gutter": false,
        "rulers": [],
        "spell_check": false,
    },

    // ctrl+[a-z] is forwarded to the shell. List any you want Sublime to keep.
    "preserve_keys": []
}
