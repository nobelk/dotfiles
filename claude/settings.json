{
  "env": {
    "CLAUDE_CODE_NO_MODEL_FALLBACK": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.test)",
      "Read(//**/.env.keys)",
      "Read(//**/.envrc)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.dev)",
      "Read(//**/.env.ci)",
      "Read(//**/.env.sentry-build-plugin)",
      "NotebookEdit",
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "CronCreate",
      "CronDelete",
      "CronList",
      "RemoteTrigger",
      "PushNotification"
    ]
  },
  "model": "claude-fable-5[1m]",
  "availableModels": [
    "opus",
    "fable"
  ],
  "statusLine": {
    "type": "command",
    "command": "sh /Users/nobelk/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": true,
    "qmd@qmd": false,
    "context7@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "qmd": {
      "source": {
        "source": "github",
        "repo": "tobi/qmd"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "high",
  "disableWorkflows": true,
  "enableArtifact": false,
  "disableRemoteControl": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "skillOverrides": {
    "jira-planner": "off",
    "sentry-cli": "off",
    "loop": "off",
    "schedule": "off"
  }
}
